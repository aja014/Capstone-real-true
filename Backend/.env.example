# Copy to Backend/.env (gitignored) and fill in. Only DATABASE_URL and SECRET_KEY are needed locally;
# every other variable is a hosting switch whose default is the local behaviour.
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/insurance_db
SECRET_KEY=<long random string>
ALGORITHM=HS256

# Hosting switches (IAS2, branch deploy-ias2). Leave unset locally.
# APP_ENV=production                 # production: refuse to start without SECRET_KEY; DB pre-ping
# CORS_ORIGINS=https://<project>.vercel.app   # comma-separated; default localhost:3000 + 5173
# DB_SSL_CA=/etc/secrets/aiven-ca.pem          # CA certificate of the DB; unset = no SSL
# DOCS_ENABLED=true                  # false hides /docs, /redoc and /openapi.json
# GIS_ENABLED=true                   # false = no geocoding / flood maps (512 MB hosts)
