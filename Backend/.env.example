# Copy to Backend/.env (gitignored) and fill in. Only DATABASE_URL and SECRET_KEY are needed locally;
# every other variable is a hosting switch whose default is the local behaviour.
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/insurance_db
SECRET_KEY=<long random string>
ALGORITHM=HS256

# Hosting switches (IAS2, branch deploy-ias2). Leave unset locally.
# APP_ENV=production                 # production: refuse to start without SECRET_KEY; DB pre-ping
# CORS_ORIGINS=https://<project>.vercel.app   # comma-separated; default localhost:3000 + 5173
# DB_SSL_CA=/etc/secrets/aiven-ca.pem          # CA certificate of the DB; unset = no SSL
# DOCS_ENABLED=true                  # false hides /docs, /redoc and /openapi.json
# GIS_ENABLED=true                   # false = no geocoding / flood maps (512 MB hosts)
# TRUSTED_PROXY_HOPS=1               # Render: client IP = last X-Forwarded-For entry; 0 = ignore it
# CLIENT_IP_SOURCE=xff_hops          # or cf-connecting-ip / true-client-ip (missing = xff_hops)
# DEBUG_CLIENT_IP=false              # temporary: true = one log line per login about the IP headers

# IAS2 round 2: stolen-password controls (no MFA). Leave unset locally (= today's behaviour).
# TOKEN_MINUTES=60                   # login token lifetime; Render: 30
# SESSION_ENDS_ON_PASSWORD_CHANGE=false   # true: a password change logs out every other device
# LOGIN_AUDIT=false                  # true: log every login attempt + login_events table (90 days) + "Last login"
# PASSWORD_MIN_LENGTH=8              # new passwords only (8-64); Render: 12
# PASSWORD_BLOCK_COMMON=false        # true: refuse the 10,000 most common passwords and the username
